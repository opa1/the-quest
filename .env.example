# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cardano network — "Preprod" or "Mainnet"
NEXT_PUBLIC_CARDANO_NETWORK=

# Blockfrost (public key used by client-side Lucid; server key used by microservice)
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=
BLOCKFROST_PROJECT_ID=

# Platform wallet — public address shown to depositors; seed is AES-256-CBC encrypted
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_SEED=
PLATFORM_WALLET_ENCRYPTION_KEY=

# Cardano microservice
CARDANO_SERVICE_URL=http://localhost:3002
CARDANO_SERVICE_SECRET=
