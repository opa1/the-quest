# Supabase (separate project per network)
NEXT_PUBLIC_SUPABASE_URL_TESTNET=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_TESTNET=
SUPABASE_SECRET_KEY_TESTNET=
NEXT_PUBLIC_SUPABASE_URL_MAINNET=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_MAINNET=
SUPABASE_SECRET_KEY_MAINNET=

# Network — front-door default ("Preprod" or "Mainnet"; set Mainnet at cutover) + Profile toggle
NEXT_PUBLIC_DEFAULT_NETWORK=Preprod
NEXT_PUBLIC_NETWORK_SWITCH_ENABLED=

# Blockfrost (server-side only; the browser goes through the /api/blockfrost proxy)
BLOCKFROST_PROJECT_ID=
BLOCKFROST_PROJECT_ID_MAINNET=

# Platform wallet — same seed both networks; the address differs per network. Seed is AES-256-CBC encrypted.
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS_TESTNET=
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS_MAINNET=
PLATFORM_WALLET_SEED=
PLATFORM_WALLET_ENCRYPTION_KEY=

# Wallet auth — derives wallet-user passwords; TESTNET must stay stable or existing logins break
WALLET_AUTH_SECRET_TESTNET=
WALLET_AUTH_SECRET_MAINNET=

# Cardano microservice
CARDANO_SERVICE_URL=http://localhost:3002
CARDANO_SERVICE_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_MAX_PROOF_IMAGE_SIZE_MB=5

# Groq
GROQ_API_KEY=

# Deadline refund cron
CRON_SECRET=
APP_URL=

# Maintenance — set to "true" to send all traffic to /maintenance during a migration/deploy
MAINTENANCE_MODE=
